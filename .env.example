DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.10
DB_ENGINE=sql_server
DB_AUTH=windows
DB_NAME=ndatabase
DB_USER=sa
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_CERT=yes
DB_CONNECTION_TIMEOUT=5
DB_CONNECTION_RETRIES=0
DB_CONNECTION_RETRY_BACKOFF=0
DB_CONN_MAX_AGE=300
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Jornada de referencia (horas) para el balance y las horas extra.
ATTENDANCE_WORKDAY_HOURS=8

# Producción LAN/HTTPS: cambia estos valores cuando el proxy o IIS sirva HTTPS.
